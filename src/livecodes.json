{
  "title": "Quran madinah",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\r\n<html lang=\"ms\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Web Al-Quran Edisi Khas Aidiladha</title>\r\n    \r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Pattaya&display=swap\" rel=\"stylesheet\">\r\n    <link rel=\"icon\" type=\"image/png\" href=\"favicon.png\">\r\n    <style>\r\n        :root {\r\n            --bg-color: #f0f4f1;\r\n            --container-bg: rgba(255, 255, 255, 0.95);\r\n            --text-color: #2c3e50;\r\n            --text-arab: #111111;\r\n            --text-muted: #555555;\r\n            --border-color: #d1e7dd;\r\n            --primary-color: #27ae60;\r\n            --accent-color: #d35400;\r\n        }\r\n\r\n        [data-theme=\"dark\"] {\r\n            --bg-color: #121b15;\r\n            --container-bg: rgba(30, 41, 34, 0.95);\r\n            --text-color: #e0e0e0;\r\n            --text-arab: #ffffff;\r\n            --text-muted: #b0b0b0;\r\n            --border-color: #2c3e26;\r\n            --primary-color: #2ecc71;\r\n            --accent-color: #e67e22;\r\n        }\r\n\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\r\n        }\r\n\r\n        /* GIMIK INTRO LOADING & LETUPAN BOM */\r\n        #intro-overlay {\r\n            position: fixed;\r\n            top: 0;\r\n            left: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            background-color: #0b130e;\r\n            display: flex;\r\n            flex-direction: column;\r\n            justify-content: center;\r\n            align-items: center;\r\n            z-index: 9999;\r\n            color: white;\r\n            transition: opacity 0.5s ease;\r\n        }\r\n\r\n        .loading-box {\r\n            text-align: center;\r\n            width: 300px;\r\n        }\r\n\r\n        .loading-text {\r\n            font-size: 18px;\r\n            margin-bottom: 10px;\r\n            letter-spacing: 1px;\r\n        }\r\n\r\n        .bar-luar {\r\n            width: 100%;\r\n            height: 20px;\r\n            background: #222;\r\n            border-radius: 10px;\r\n            overflow: hidden;\r\n            border: 2px solid #27ae60;\r\n        }\r\n\r\n        .bar-dalam {\r\n            width: 0%;\r\n            height: 100%;\r\n            background: linear-gradient(90deg, #2ecc71, #27ae60);\r\n            transition: width 0.1s linear;\r\n        }\r\n\r\n        /* Animasi Bom Meletup & Ucapan */\r\n        .efek-letupan {\r\n            display: none;\r\n            text-align: center;\r\n            animation: kaboom 0.4s ease-out;\r\n        }\r\n\r\n        .teks-raya {\r\n            font-family: 'Pattaya', sans-serif;\r\n            font-size: 36px;\r\n            color: #f1c40f;\r\n            text-shadow: 0 0 20px #e67e22;\r\n            margin-top: 20px;\r\n            line-height: 1.5;\r\n            opacity: 0;\r\n            animation: munculTeks 2s forwards 0.5s;\r\n        }\r\n\r\n        @keyframes kaboom {\r\n            0% { transform: scale(0.1); background: #ffffff; box-shadow: 0 0 10px #fff; }\r\n            50% { background: #ff5722; box-shadow: 0 0 100px 50px #ff5722, 0 0 200px 100px #f1c40f; }\r\n            100% { transform: scale(1.5); opacity: 0; }\r\n        }\r\n\r\n        @keyframes munculTeks {\r\n            to { opacity: 1; }\r\n        }\r\n\r\n        /* STRUKTUR UTAMA UTK BACKGROUND HARI RAYA KORBAN */\r\n        body {\r\n            background-color: var(--bg-color);\r\n            color: var(--text-color);\r\n            padding: 20px;\r\n            min-height: 100vh;\r\n            /* Latar belakang ilustrasi suasana padang raya, lembu, dan imam secara CSS minimalis/siluet */\r\n            background-image: \r\n                radial-gradient(circle at 80% 20%, #f1c40f 0%, transparent 10%),\r\n                linear-gradient(to top, #27ae60 0%, transparent 40%);\r\n            background-attachment: fixed;\r\n        }\r\n\r\n        /* Elemen Hiasan Lembu & Imam (Menggunakan Emoji Besar sebagai Grafik Mudah) */\r\n        .hiasan-raya {\r\n            position: fixed;\r\n            bottom: 10px;\r\n            right: 20px;\r\n            font-size: 70px;\r\n            z-index: -1;\r\n            user-select: none;\r\n            opacity: 0.8;\r\n            filter: drop-shadow(2px 2px 5px rgba(0,0,0,0.2));\r\n        }\r\n        .hiasan-raya::after {\r\n            content: \"🕌 🧔‍♂️ 🔪 🐂\"; /* Imam, pisau dan lembu suasanan korban */\r\n        }\r\n\r\n        .container {\r\n            max-width: 800px;\r\n            margin: 0 auto;\r\n            background: var(--container-bg);\r\n            padding: 30px;\r\n            border-radius: 12px;\r\n            box-shadow: 0 8px 30px rgba(0,0,0,0.15);\r\n            backdrop-filter: blur(5px);\r\n        }\r\n\r\n        .badge-container {\r\n            display: flex;\r\n            gap: 10px;\r\n            margin-bottom: 15px;\r\n            flex-wrap: wrap;\r\n        }\r\n\r\n        .badge {\r\n            padding: 4px 12px;\r\n            border-radius: 20px;\r\n            font-size: 11px;\r\n            font-weight: bold;\r\n        }\r\n        .badge-halal { border: 2px solid #27ae60; color: #27ae60; }\r\n        .badge-original { background: #34495e; color: #fff; }\r\n        .badge-raya { background: #d35400; color: #fff; }\r\n\r\n        header {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: flex-start;\r\n            margin-bottom: 25px;\r\n            border-bottom: 2px solid var(--border-color);\r\n            padding-bottom: 20px;\r\n        }\r\n\r\n        h1 { color: var(--primary-color); font-size: 24px; }\r\n\r\n        .header-buttons { display: flex; gap: 10px; flex-wrap: wrap; }\r\n\r\n        .btn-action {\r\n            color: white;\r\n            border: none;\r\n            padding: 8px 16px;\r\n            border-radius: 20px;\r\n            cursor: pointer;\r\n            font-weight: bold;\r\n            font-size: 13px;\r\n        }\r\n        .btn-peristiwa { background: #e67e22; }\r\n        .btn-tutorial { background: #f39c12; }\r\n        .btn-tema { background: var(--primary-color); }\r\n\r\n        /* INPUT SEARCH & SELECT */\r\n        .search-box, .pilihan-surah {\r\n            width: 100%;\r\n            padding: 12px;\r\n            font-size: 16px;\r\n            border-radius: 8px;\r\n            border: 1px solid var(--border-color);\r\n            background-color: var(--container-bg);\r\n            color: var(--text-color);\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        /* PAPARAN AYAT AL-QURAN */\r\n        .ayat-box {\r\n            padding: 20px;\r\n            border-bottom: 1px dashed var(--border-color);\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 15px;\r\n        }\r\n\r\n        .teks-arab {\r\n            font-size: 32px;\r\n            text-align: right;\r\n            direction: rtl;\r\n            font-family: 'Amiri', serif;\r\n            line-height: 2.2;\r\n            color: var(--text-arab);\r\n        }\r\n\r\n        .teks-terjemahan {\r\n            font-size: 15px;\r\n            color: var(--text-muted);\r\n            line-height: 1.6;\r\n        }\r\n\r\n        .nombor-ayat {\r\n            display: inline-block;\r\n            background: var(--primary-color);\r\n            color: white;\r\n            padding: 2px 8px;\r\n            border-radius: 50%;\r\n            font-size: 12px;\r\n            margin-right: 10px;\r\n        }\r\n\r\n        /* MODAL / SKRIN PERISTIWA HARI RAYA KORBAN */\r\n        .modal-peristiwa {\r\n            display: none;\r\n            position: fixed;\r\n            top: 0; left: 0; width: 100%; height: 100%;\r\n            background: var(--bg-color);\r\n            z-index: 2000;\r\n            overflow-y: auto;\r\n            padding: 30px 20px;\r\n        }\r\n\r\n        .peristiwa-content {\r\n            max-width: 700px;\r\n            margin: 0 auto;\r\n            background: var(--container-bg);\r\n            padding: 30px;\r\n            border-radius: 12px;\r\n            box-shadow: 0 4px 20px rgba(0,0,0,0.1);\r\n        }\r\n\r\n        .peristiwa-content h2 {\r\n            color: #d35400;\r\n            margin-bottom: 20px;\r\n            border-bottom: 3px solid #e67e22;\r\n            padding-bottom: 10px;\r\n        }\r\n\r\n        .peristiwa-text {\r\n            line-height: 1.8;\r\n            font-size: 15px;\r\n            margin-bottom: 20px;\r\n        }\r\n\r\n        .peristiwa-text h3 {\r\n            margin-top: 20px;\r\n            color: var(--primary-color);\r\n        }\r\n\r\n        .btn-back {\r\n            background: #c0392b;\r\n            color: white;\r\n            border: none;\r\n            padding: 10px 20px;\r\n            border-radius: 8px;\r\n            cursor: pointer;\r\n            font-weight: bold;\r\n            font-size: 14px;\r\n        }\r\n\r\n        /* POPUP TUTORIAL */\r\n        .modal-tutorial {\r\n            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;\r\n            background: rgba(0,0,0,0.6); justify-content: center; align-items: center; z-index: 1500;\r\n        }\r\n        .tutorial-content {\r\n            background: var(--container-bg); padding: 30px; border-radius: 12px; max-width: 500px; width: 90%;\r\n        }\r\n        .tutorial-content ul { margin: 15px 0 20px 20px; line-height: 1.8; }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <div id=\"intro-overlay\">\r\n        <div class=\"loading-box\" id=\"kotak-loading\">\r\n            <div class=\"loading-text\">MEMUATKAN SISTEM... <span id=\"angka-loading\">0</span>%</div>\r\n            <div class=\"bar-luar\">\r\n                <div class=\"bar-dalam\" id=\"progress-bar\"></div>\r\n            </div>\r\n        </div>\r\n        <div class=\"efek-letupan\" id=\"zon-letupan\">\r\n            <div style=\"font-size: 80px;\">💥💥💥</div>\r\n            <div class=\"teks-raya\">\r\n                ✨ SELAMAT HARI RAYA HAJI & ARAFAH ✨<br>\r\n                <span style=\"font-size: 20px; color: #fff;\">Ibadah Korban Membawa Berkat</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"hiasan-raya\"></div>\r\n\r\n    <div class=\"container\">\r\n        <div class=\"badge-container\">\r\n            <span class=\"badge badge-halal\">🟢 HALAL QURAN WEB</span>\r\n            <span class=\"badge badge-original\">✔ ORIGINAL DATA VERIFIED</span>\r\n            <span class=\"badge badge-raya\">🕋 EDISI RAYA KORBAN</span>\r\n        </div>\r\n\r\n        <header>\r\n            <div>\r\n                <h1>Al-Quran Digital Pro</h1>\r\n                <p style=\"font-size: 13px; color: var(--text-muted);\">Penghayatan Al-Quran & Sirah Islam</p>\r\n            </div>\r\n            <div class=\"header-buttons\">\r\n                <button class=\"btn-action btn-peristiwa\" id=\"btn-buka-peristiwa\">🐂 Peristiwa Korban</button>\r\n                <button class=\"btn-action btn-tutorial\" id=\"btn-buka-tutorial\">💡 Panduan</button>\r\n                <button class=\"btn-action btn-tema\" id=\"btn-tema\">🌙 Tema</button>\r\n            </div>\r\n        </header>\r\n\r\n        <input type=\"text\" id=\"kotak-carian\" class=\"search-box\" placeholder=\"Cari nama atau nombor surah...\">\r\n        <select id=\"senarai-surah\" class=\"pilihan-surah\">\r\n            <option value=\"\">-- Memuatkan surah... --</option>\r\n        </select>\r\n\r\n        <main id=\"papar-surah\">\r\n            <p style=\"text-align: center; font-style: italic; color: var(--text-muted);\">Sila pilih surah di atas untuk memulakan bacaan.</p>\r\n        </main>\r\n    </div>\r\n\r\n    <div class=\"modal-peristiwa\" id=\"modal-peristiwa\">\r\n        <div class=\"peristiwa-content\">\r\n            <h2>🕋 Peristiwa Hari Raya Korban & Sejarahnya</h2>\r\n            <div class=\"peristiwa-text\">\r\n                <p>Hari Raya Korban (Aidiladha) disambut bagi memperingati kisah pengorbanan agung dalam sejarah Islam yang melibatkan **Nabi Ibrahim A.S.** dan anakandanya **Nabi Ismail A.S.**</p>\r\n                \r\n                <h3>1. Perintah Melalui Mimpi</h3>\r\n                <p>Nabi Ibrahim A.S. mendapat perintah daripada Allah SWT melalui mimpi untuk menyembelih anak kesayangannya, Nabi Ismail A.S. Walaupun ia satu ujian yang amat berat, baginda tetap patuh, begitu juga Nabi Ismail yang redha dengan perintah khaliknya.</p>\r\n                \r\n                <h3>2. Detik Penyembelihan & Mukjizat</h3>\r\n                <p>Ketika pisau diletakkan di leher Nabi Ismail A.S., dengan kuasa Allah SWT, pisau tersebut tidak mampu melukakannya. Serta-merta, Allah menggantikan tempat Nabi Ismail dengan **seekor kibas (biri-biri/kambing)** yang besar dari syurga untuk disembelih.</p>\r\n                \r\n                <h3>3. Pengajaran Utama Ibadah Korban</h3>\r\n                <p>Daripada peristiwa inilah bermulanya syariat ibadah korban (menyembelih ternakan seperti lembu, kambing, atau unta) pada setiap 10, 11, 12, dan 13 Zulhijjah. Ia mendidik umat Islam tentang erti ketaatan mutlak, keikhlasan, dan sifat berkongsi rezeki dengan golongan fakir miskin.</p>\r\n            </div>\r\n            <button class=\"btn-back\" id=\"btn-tutup-peristiwa\">⬅ Back (Kembali Ke Al-Quran)</button>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal-tutorial\" id=\"modal-panduan\">\r\n        <div class=\"tutorial-content\">\r\n            <h2 style=\"color: #f39c12;\">💡 Cara Menggunakan Laman Web</h2>\r\n            <ul>\r\n                <li><strong>Cari Surah:</strong> Taip nama surah pada kotak carian di skrin utama.</li>\r\n                <li><strong>Membaca:</strong> Pilih surah daripada menu lungsur untuk melihat teks Arab serta terjemahannya.</li>\r\n                <li><strong>Peristiwa Korban:</strong> Tekan butang oren \"Peristiwa Korban\" untuk membaca sirah lengkap, dan tekan \"Back\" untuk kembali membaca Al-Quran.</li>\r\n            </ul>\r\n            <button class=\"btn-back\" style=\"background:#555;\" id=\"btn-tutup-tutorial\">Tutup</button>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        // Logik Loading Gimik 0% - 100%\r\n        const overlay = document.getElementById('intro-overlay');\r\n        const kotakLoading = document.getElementById('kotak-loading');\r\n        const angkaLoading = document.getElementById('angka-loading');\r\n        const progressBar = document.getElementById('progress-bar');\r\n        const zonLetupan = document.getElementById('zon-letupan');\r\n\r\n        let count = 0;\r\n        let counter = setInterval(() => {\r\n            count++;\r\n            angkaLoading.textContent = count;\r\n            progressBar.style.width = count + '%';\r\n\r\n            if(count === 100) {\r\n                clearInterval(counter);\r\n                // Selesai loading, sorokkan teks loading biasa\r\n                kotakLoading.style.display = 'none';\r\n                \r\n                // Nyalakan letupan bom & ucapan raya\r\n                zonLetupan.style.display = 'block';\r\n                zonLetupan.style.animation = 'kaboom 0.5s ease-out';\r\n\r\n                // Selepas 3 saat ucapan dipaparkan, hilangkan skrin intro secara penuh\r\n                setTimeout(() => {\r\n                    overlay.style.opacity = '0';\r\n                    setTimeout(() => overlay.style.display = 'none', 500);\r\n                }, 3500);\r\n            }\r\n        }, 30); // Kelajuan loading\r\n\r\n        // Pembolehubah Utama Al-Quran\r\n        const senaraiSurahSelect = document.getElementById('senarai-surah');\r\n        const paparSurahDiv = document.getElementById('papar-surah');\r\n        const kotakCarian = document.getElementById('kotak-carian');\r\n        const btnTema = document.getElementById('btn-tema');\r\n        \r\n        // Modal Peristiwa & Tutorial\r\n        const mPeristiwa = document.getElementById('modal-peristiwa');\r\n        const btnBukaPeristiwa = document.getElementById('btn-buka-peristiwa');\r\n        const btnTutupPeristiwa = document.getElementById('btn-tutup-peristiwa');\r\n        \r\n        const mTutorial = document.getElementById('modal-panduan');\r\n        const btnBukaTutorial = document.getElementById('btn-buka-tutorial');\r\n        const btnTutupTutorial = document.getElementById('btn-tutup-tutorial');\r\n\r\n        let semuaSurah = [];\r\n\r\n        // Ambil Senarai Surah\r\n        async function muatSenaraiSurah() {\r\n            try {\r\n                const respon = await fetch('https://api.alquran.cloud/v1/surah');\r\n                const data = await respon.json();\r\n                semuaSurah = data.data;\r\n                paparkanDropdown(semuaSurah);\r\n            } catch (r) {\r\n                senaraiSurahSelect.innerHTML = '<option>Gagal memuatkan data surah.</option>';\r\n            }\r\n        }\r\n\r\n        function paparkanDropdown(senarai) {\r\n            senaraiSurahSelect.innerHTML = '<option value=\"\">-- Pilih Surah --</option>';\r\n            senarai.forEach(s => {\r\n                const opt = document.createElement('option');\r\n                opt.value = s.number;\r\n                opt.textContent = `${s.number}. ${s.englishName} (${s.name})`;\r\n                senaraiSurahSelect.appendChild(opt);\r\n            });\r\n        }\r\n\r\n        // Ambil Ayat Al-Quran\r\n        async function muatAyatSurah(no) {\r\n            if(!no) return;\r\n            paparSurahDiv.innerHTML = '<p style=\"text-align:center;font-style:italic;\">Sedang memuatkan ayat...</p>';\r\n            try {\r\n                const rArab = await fetch(`https://api.alquran.cloud/v1/surah/${no}`);\r\n                const rTerj = await fetch(`https://api.alquran.cloud/v1/surah/${no}/en.sahih`);\r\n                const dArab = await rArab.json();\r\n                const dTerj = await rTerj.json();\r\n\r\n                paparSurahDiv.innerHTML = '';\r\n                dArab.data.ayahs.forEach((ayat, i) => {\r\n                    const div = document.createElement('div');\r\n                    div.classList.add('ayat-box');\r\n                    div.innerHTML = `\r\n                        <div class=\"teks-arab\">${ayat.text}</div>\r\n                        <div class=\"teks-terjemahan\"><span class=\"nombor-ayat\">${ayat.numberInSurah}</span> ${dTerj.data.ayahs[i].text}</div>\r\n                    `;\r\n                    paparSurahDiv.appendChild(div);\r\n                });\r\n            } catch (e) {\r\n                paparSurahDiv.innerHTML = '<p>Ralat memuatkan ayat.</p>';\r\n            }\r\n        }\r\n\r\n        // Logik Carian\r\n        kotakCarian.addEventListener('input', (e) => {\r\n            const k = e.target.value.toLowerCase();\r\n            const hasil = semuaSurah.filter(s => s.englishName.toLowerCase().includes(k) || s.number.toString().includes(k));\r\n            paparkanDropdown(hasil);\r\n        });\r\n\r\n        // Pengurusan Butang & Modal (Buka / Back)\r\n        btnBukaPeristiwa.addEventListener('click', () => mPeristiwa.style.display = 'block');\r\n        btnTutupPeristiwa.addEventListener('click', () => mPeristiwa.style.display = 'none');\r\n        \r\n        btnBukaTutorial.addEventListener('click', () => mTutorial.style.display = 'flex');\r\n        btnTutupTutorial.addEventListener('click', () => mTutorial.style.display = 'none');\r\n\r\n        senaraiSurahSelect.addEventListener('change', (e) => muatAyatSurah(e.target.value));\r\n        \r\n        btnTema.addEventListener('click', () => {\r\n            const t = document.documentElement.getAttribute('data-theme');\r\n            t === 'dark' ? document.documentElement.removeAttribute('data-theme') : document.documentElement.setAttribute('data-theme', 'dark');\r\n        });\r\n\r\n        muatSenaraiSurah();\r\n    </script>\r\n</body>\r\n</html>"
  },
